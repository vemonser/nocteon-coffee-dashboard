# ─────────────────────────────────────────────────────────────
# E2E credentials — COPY THIS FILE TO .env.local AND FILL IN.
# .env.local is gitignored. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────

# Base URL of the running Angular dev server
E2E_BASE_URL=http://localhost:4200

# Admin account — must reach the dashboard.
E2E_ADMIN_EMAIL=admin@aurum.local
E2E_ADMIN_PASSWORD=

# Non-admin account — must be BLOCKED from the dashboard.
E2E_USER_EMAIL=sara@example.com
E2E_USER_PASSWORD=
